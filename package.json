{
  "name": "OBVCarService.Bot",
  "version": "1.0.0",
  "description": "Polls Binotel for new calls, transcribes them, classifies each call and attributes it to a manager, and stores everything in Postgres for a separate reporting bot to consume",
  "main": "src/jobs/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i tailwind/input.css -o src/bot/site/app.css --minify",
    "poll": "cross-env JOB_TYPE=poll node src/jobs/index.js",
    "bot": "node src/bot/index.js",
    "test:call": "node src/scripts/testSingleCall.js",
    "backfill": "node src/scripts/backfill.js",
    "reattribute:shared": "node src/scripts/reattributeShared.js",
    "retranscribe:recent": "node src/scripts/retranscribeRecent.js",
    "retranscribe:last": "node src/scripts/retranscribeLast.js",
    "backfill:analysis": "node src/scripts/backfillAnalysis.js",
    "backfill:purpose": "node src/scripts/backfillPurpose.js",
    "backfill:personal": "node src/scripts/backfillPersonal.js",
    "backfill:declines": "node src/scripts/backfillDeclines.js",
    "build:site": "node src/scripts/buildReportSite.js",
    "warm:global": "node src/scripts/warmGlobalReport.js",
    "normalize:operators": "node src/scripts/normalizeOperators.js",
    "backfill:direction": "node src/scripts/backfillDirection.js",
    "backfill:intro": "node src/scripts/backfillIntro.js",
    "rescore:intro": "node src/scripts/rescoreIntro.js",
    "backfill:clientnumbers": "node src/scripts/backfillClientNumbers.js",
    "backfill:audio": "node src/scripts/backfillAudio.js",
    "backfill:blockers": "node src/scripts/backfillBlockers.js",
    "kb:reindex": "node src/scripts/reindexKb.js",
    "rescore:sales": "node src/scripts/rescoreSales.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.3"
  }
}
